{
  "expo": {
    "name": "Sini",
    "slug": "siniai",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sini",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.destyastudio.sini",
      "buildNumber": "3",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.destyastudio.sini",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#3B2938",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "destyastudio.com",
              "pathPrefix": "/sini"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5EEE6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-router",
      "expo-font",
      "expo-updates",
      "expo-web-browser",
      [
        "react-native-iap",
        {
          "paymentProvider": "both"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableHermes": true,
            "extraGradleProps": {
              "org.gradle.jvmargs": "-Xmx6144m -XX:MaxMetaspaceSize=2048m -XX:+HeapDumpOnOutOfMemoryError"
            }
          },
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "./plugins/with-android-kotlin-version",
        {
          "version": "2.3.0"
        }
      ],
      "./plugins/withAndroidResolutionStrategy",
      "./withIosFmtWorkaround.js",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/messaging",
      "expo-notifications",
      "expo-localization"
    ],
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/98499755-4c9f-47ac-a171-efd55333fbf8"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98499755-4c9f-47ac-a171-efd55333fbf8"
      }
    },
    "owner": "mindcraftlearning"
  }
}
