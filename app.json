{
  "expo": {
    "name": "Sini AI",
    "slug": "siniai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "siniai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.destyastudio.siniai",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.destyastudio.siniai",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#3B2938",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "destyastudio.com",
              "pathPrefix": "/sini-ai"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "./plugins/with-android-kotlin-version",
        {
          "version": "2.3.0"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98499755-4c9f-47ac-a171-efd55333fbf8"
      }
    },
    "owner": "mindcraftlearning"
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-7433519007687449~9269190746",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
  }
}
